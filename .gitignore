# Next.js telemetry & cache
.next/cache
*.tsbuildinfo
next-env.d.ts.bak

# Operating System files
.DS_Store
*.pem
Thumbs.db
ehthumbs.db

# IDE & Editor settings
.vscode/
.idea/
*.sublime-workspace
*.sublime-project

# Temporary files & uploads
/temp
/scratch
*.tmp
*.log
