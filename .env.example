# =================================================================
# EasyPDF - Environment Configuration Template
# Copy this file to .env.local and update with your credentials
# =================================================================

# MySQL / MariaDB Database Configuration (e.g. XAMPP, Docker, Cloud DB)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=easypdf

# Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Security & Session Secrets (Replace with random strings in production)
JWT_SECRET=your_jwt_secret_token_key_here
ADMIN_SECRET=your_admin_session_secret_key_here
FILE_TOKEN_SECRET=your_file_hmac_signing_secret_key_here

# Administrator Account Credentials
ADMIN_EMAIL=mubinulhq@gmail.com
ADMIN_PASSWORD=your_admin_password_here
