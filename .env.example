# =================================================================
# EasyPDF - Environment Configuration Template
# Copy this file to .env.local and update with your values.
# NEVER commit .env.local to version control.
# =================================================================

# MySQL / MariaDB Database Configuration
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=easypdf

# Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# =============================================================
# SECURITY SECRETS — REQUIRED IN PRODUCTION
# Generate strong values with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# All secrets must be at least 32 characters long.
# =============================================================

# HMAC signing key for admin session tokens (REQUIRED — minimum 32 chars)
ADMIN_SECRET=replace_with_strong_random_secret_min_32_chars

# HMAC signing key for file access tokens (REQUIRED — minimum 32 chars)
FILE_TOKEN_SECRET=replace_with_another_strong_random_secret_min_32_chars

# =============================================================
# ADMINISTRATOR ACCOUNT
# =============================================================
ADMIN_EMAIL=your_admin_email@example.com
ADMIN_PASSWORD=your_admin_password_here
ADMIN_NAME=Administrator
